{
  "expo": {
    "name": "Herufi",
    "slug": "herufi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "herufi",
    "userInterfaceStyle": "automatic",
    "description": "Buy direct from China, delivered to Tanzania. Free sea shipping, pay with M-Pesa or card.",
    "ios": {
      "bundleIdentifier": "tz.co.herufi.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Herufi uses your photos so you can set a profile picture."
      }
    },
    "android": {
      "package": "tz.co.herufi.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": { "backgroundColor": "#0E0E0D", "image": "./assets/images/splash-icon-dark.png" }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-image-picker",
        { "photosPermission": "Herufi uses your photos so you can set a profile picture." }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
